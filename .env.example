# Copier en ".env" (à côté de docker-compose.yml) pour changer un réglage, puis : docker compose up -d

# Version de l'application (tags : https://github.com/users/rouxhero/packages/container/package/a3-lean)
# A3_VERSION=latest

# Port local
# A3_PORT=8000

# Nom de l'auteur affiché dans les versions et les notes
# A3_AUTEUR=moi

# IA : modèle Ollama (plus gros = meilleurs textes, plus de RAM : qwen2.5:7b ≈ 6 Go)
# A3_LLM_MODEL=qwen2.5:3b
# Autre serveur compatible OpenAI (OpenAI, LM Studio, Ollama sur une autre machine…) :
# A3_LLM_URL=https://api.openai.com/v1
# A3_LLM_MODEL=gpt-4o-mini
# A3_LLM_API_KEY=sk-...
# Délai max d'une réponse en secondes (CPU lent → augmenter)
# A3_LLM_TIMEOUT=600

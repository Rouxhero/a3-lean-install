# Copier en ".env" (à côté de docker-compose.yml) pour changer un réglage, puis : docker compose up -d

# Version de l'application (tags : https://github.com/users/rouxhero/packages/container/package/a3-lean)
# A3_VERSION=latest

# Port local
# A3_PORT=8000

# Nom de l'auteur affiché dans les versions et les notes
# A3_AUTEUR=moi

# IA : modèle Ollama (plus gros = meilleurs textes, plus de RAM : qwen2.5:7b ≈ 6 Go)
# A3_LLM_MODEL=qwen2.5:3b
# Autre serveur compatible OpenAI (OpenAI, LM Studio, Ollama sur une autre machine…) :
# A3_LLM_URL=https://api.openai.com/v1
# A3_LLM_MODEL=gpt-4o-mini
# A3_LLM_API_KEY=sk-...
# Délai max d'une réponse en secondes (CPU lent → augmenter)
# A3_LLM_TIMEOUT=600

# Outils IA externes (serveur MCP /mcp, jetons créés dans Réglages) : 0 pour le couper
# A3_MCP=1

# ---------- Travailler à plusieurs (comptes) ----------
# connexion : page de connexion (code reçu par e-mail ou SSO), chaque personne ne voit que ses rapports et ceux
# qu'on lui partage. aucune : pas de connexion (une seule personne, ou un proxy qui pose X-authentik-*).
# A3_AUTH=connexion
# Adresse publique (liens des e-mails, redirection SSO), ex. https://a3.exemple.fr
# A3_PUBLIC_URL=
# Administrateurs (e-mails, séparés par des virgules). Vide : le premier compte créé devient administrateur.
# A3_ADMINS=moi@exemple.fr
# Envoi des codes et invitations (modifiable aussi dans l'appli : volet 🔐 Admin). Sans SMTP, les codes sont
# écrits dans les journaux : docker compose logs a3-lean
# A3_SMTP_HOST=smtp.exemple.fr
# A3_SMTP_PORT=587
# A3_SMTP_SECURITY=starttls      # starttls | ssl | aucune
# A3_SMTP_USER=noreply@exemple.fr
# A3_SMTP_PASSWORD=
# A3_SMTP_FROM=noreply@exemple.fr
# SSO OpenID Connect (Authentik, Keycloak, Google…) ; redirection à déclarer : <A3_PUBLIC_URL>/auth/oidc/retour
# A3_OIDC_NAME=Authentik
# A3_OIDC_ISSUER=https://auth.exemple.fr/application/o/a3-lean/
# A3_OIDC_CLIENT_ID=
# A3_OIDC_CLIENT_SECRET=
# Derrière un proxy à « forward auth » qui pose X-authentik-username / name / email (ancien fonctionnement)
# A3_TRUST_PROXY_HEADERS=1
